/*
Title: circle
Authors: liixini | https://github.com/liixini 
Desc: imported from https://github.com/liixini/shaders
*/

animations {
   workspace-switch {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }
	horizontal-view-movement {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    config-notification-open-close {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    exit-confirmation-open-close {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }

    overview-open-close {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    recent-windows-close {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    window-open {
        duration-ms 500
        curve "ease-out-cubic"
        custom-shader r"
        vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                            float p = niri_clamped_progress;
                            vec2 uv = coords_geo.xy;
                            float seed = niri_random_seed;
            
                            float smoothness = 0.3;
                            float SQRT_2 = 1.414213562;
            
                            vec2 center = vec2(0.5 + (seed - 0.5) * 0.15, 0.5 + (seed * 0.7 - 0.35) * 0.15);
            
                            float dist = SQRT_2 * distance(center, uv);
                            float m = smoothstep(-smoothness, 0.0, dist - p * (1.0 + smoothness));
                            float reveal = 1.0 - m;
            
                            vec3 tc = niri_geo_to_tex * vec3(uv, 1.0);
                            vec4 color = texture2D(niri_tex, tc.st);
            
                            return color * reveal;
                        }
        "
    }

    window-close {
        duration-ms 500
        curve "ease-out-cubic"
        custom-shader r"
        vec4 close_color(vec3 coords_geo, vec3 size_geo) {
            float p = niri_clamped_progress;
            vec2 uv = coords_geo.xy;
            float seed = niri_random_seed;

            float smoothness = 0.3;
            float SQRT_2 = 1.414213562;

            // Slightly randomized center
            vec2 center = vec2(0.5 + (seed - 0.5) * 0.15, 0.5 + (seed * 0.7 - 0.35) * 0.15);

            float dist = SQRT_2 * distance(center, uv);
            float m = smoothstep(-smoothness, 0.0, dist - (1.0 - p) * (1.0 + smoothness));
            float remain = 1.0 - m;

            vec3 tc = niri_geo_to_tex * vec3(uv, 1.0);
            vec4 color = texture2D(niri_tex, tc.st);

            return color * remain;
        }
        "
    }
}
