/*
Title: perlin
Authors: liixini | https://github.com/liixini 
Desc: imported from https://github.com/liixini/shaders
*/

animations {
   workspace-switch {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }
	horizontal-view-movement {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    config-notification-open-close {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    exit-confirmation-open-close {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }

    overview-open-close {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    recent-windows-close {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    window-open {
		duration-ms 500
		curve "ease-out-cubic"
        custom-shader r"

        // Ported from skwd-wall perlin transition

        float perlin_random(vec2 co) {
            float a = 12.9898;
            float b = 78.233;
            float c = 43758.5453;
            float dt = dot(co.xy, vec2(a, b));
            float sn = mod(dt, 3.14);
            return fract(sin(sn) * c);
        }

        float perlin_noise(in vec2 st) {
            vec2 i = floor(st);
            vec2 f = fract(st);
            float a = perlin_random(i);
            float b = perlin_random(i + vec2(1.0, 0.0));
            float c = perlin_random(i + vec2(0.0, 1.0));
            float d = perlin_random(i + vec2(1.0, 1.0));
            vec2 u = f * f * (3.0 - 2.0 * f);
            return mix(a, b, u.x) +
                (c - a) * u.y * (1.0 - u.x) +
                (d - b) * u.x * u.y;
        }

        vec4 open_color(vec3 coords_geo, vec3 size_geo) {
            float pr = niri_clamped_progress;
            vec2 uv = coords_geo.xy;
            vec3 tc = niri_geo_to_tex * vec3(uv, 1.0);
            vec4 win = texture2D(niri_tex, tc.st);

            float scale = 4.0;
            float smoothness = 0.01;
            float n = perlin_noise(uv * scale);
            float p = mix(-smoothness, 1.0 + smoothness, pr);
            float lower = p - smoothness;
            float higher = p + smoothness;
            float q = smoothstep(lower, higher, n);
            float reveal = 1.0 - q;

            return win * reveal;
        }
        "
    }

    window-close {
       	duration-ms 500
       	curve "ease-out-cubic"
        custom-shader r"

        // Ported from skwd-wall perlin transition

        float perlin_random(vec2 co) {
            float a = 12.9898;
            float b = 78.233;
            float c = 43758.5453;
            float dt = dot(co.xy, vec2(a, b));
            float sn = mod(dt, 3.14);
            return fract(sin(sn) * c);
        }

        float perlin_noise(in vec2 st) {
            vec2 i = floor(st);
            vec2 f = fract(st);
            float a = perlin_random(i);
            float b = perlin_random(i + vec2(1.0, 0.0));
            float c = perlin_random(i + vec2(0.0, 1.0));
            float d = perlin_random(i + vec2(1.0, 1.0));
            vec2 u = f * f * (3.0 - 2.0 * f);
            return mix(a, b, u.x) +
                (c - a) * u.y * (1.0 - u.x) +
                (d - b) * u.x * u.y;
        }

        vec4 close_color(vec3 coords_geo, vec3 size_geo) {
            float pr = 1.0 - niri_clamped_progress;
            vec2 uv = coords_geo.xy;
            vec3 tc = niri_geo_to_tex * vec3(uv, 1.0);
            vec4 win = texture2D(niri_tex, tc.st);

            float scale = 4.0;
            float smoothness = 0.01;
            float n = perlin_noise(uv * scale);
            float p = mix(-smoothness, 1.0 + smoothness, pr);
            float lower = p - smoothness;
            float higher = p + smoothness;
            float q = smoothstep(lower, higher, n);
            float reveal = 1.0 - q;

            return win * reveal;
        }
        "
    }
}
