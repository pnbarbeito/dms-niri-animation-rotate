/*
Title: morph
Authors: liixini | https://github.com/liixini 
Desc: imported from https://github.com/liixini/shaders
*/

animations {
   workspace-switch {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }
	horizontal-view-movement {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    config-notification-open-close {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    exit-confirmation-open-close {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }

    overview-open-close {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    recent-windows-close {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    window-open {
		duration-ms 500
		curve "ease-out-cubic"
        custom-shader r"

        // Ported from skwd-wall morph transition

        vec4 open_color(vec3 coords_geo, vec3 size_geo) {
            float p = niri_clamped_progress;
            vec2 uv = coords_geo.xy;
            float strength_v = 0.15;

            vec3 tc0 = niri_geo_to_tex * vec3(uv, 1.0);
            vec4 cb = texture2D(niri_tex, tc0.st);
            vec2 ob = ((cb.rg + cb.b) * 0.5) * 2.0 - 1.0;
            vec2 oc = ob * strength_v;
            float w1 = 1.0 - p;

            vec2 sample_uv = uv - oc * w1;
            vec3 tc = niri_geo_to_tex * vec3(sample_uv, 1.0);
            vec4 win = texture2D(niri_tex, tc.st);

            return win * p;
        }
        "
    }

    window-close {
       	duration-ms 500
       	curve "ease-out-cubic"
        custom-shader r"

        // Ported from skwd-wall morph transition

        vec4 close_color(vec3 coords_geo, vec3 size_geo) {
            float p = 1.0 - niri_clamped_progress;
            vec2 uv = coords_geo.xy;
            float strength_v = 0.15;

            vec3 tc0 = niri_geo_to_tex * vec3(uv, 1.0);
            vec4 cb = texture2D(niri_tex, tc0.st);
            vec2 ob = ((cb.rg + cb.b) * 0.5) * 2.0 - 1.0;
            vec2 oc = ob * strength_v;
            float w1 = 1.0 - p;

            vec2 sample_uv = uv - oc * w1;
            vec3 tc = niri_geo_to_tex * vec3(sample_uv, 1.0);
            vec4 win = texture2D(niri_tex, tc.st);

            return win * p;
        }
        "
    }
}
