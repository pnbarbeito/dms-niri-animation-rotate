/*
Title: randomsquares
Authors: liixini | https://github.com/liixini 
Desc: imported from https://github.com/liixini/shaders
*/

animations {
   workspace-switch {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }
	horizontal-view-movement {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    config-notification-open-close {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    exit-confirmation-open-close {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }

    overview-open-close {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    recent-windows-close {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    window-open {
		duration-ms 500
		curve "ease-out-cubic"
        custom-shader r"
        // Ported from skwd-wall randomsquares transition
        
		float rs_rand(vec2 co) {
            return fract(sin(dot(co.xy, vec2(12.9898, 78.233))) * 43758.5453);
        }

        vec4 open_color(vec3 coords_geo, vec3 size_geo) {
            float p = niri_clamped_progress;
            vec2 uv = coords_geo.xy;
            vec3 tc = niri_geo_to_tex * vec3(uv, 1.0);
            vec4 win = texture2D(niri_tex, tc.st);

            vec2 sz = vec2(10.0, 10.0);
            float smoothness = 0.5;
            float r = rs_rand(floor(sz * uv));
            float reveal = smoothstep(0.0, -smoothness, r - (p * (1.0 + smoothness)));

            return win * reveal;
        }
        "
    }

    window-close {
       	duration-ms 500
       	curve "ease-out-cubic"
        custom-shader r"
        // Ported from skwd-wall randomsquares transition

        float rs_rand(vec2 co) {
            return fract(sin(dot(co.xy, vec2(12.9898, 78.233))) * 43758.5453);
        }

        vec4 close_color(vec3 coords_geo, vec3 size_geo) {
            float p = 1.0 - niri_clamped_progress;
            vec2 uv = coords_geo.xy;
            vec3 tc = niri_geo_to_tex * vec3(uv, 1.0);
            vec4 win = texture2D(niri_tex, tc.st);

            vec2 sz = vec2(10.0, 10.0);
            float smoothness = 0.5;
            float r = rs_rand(floor(sz * uv));
            float reveal = smoothstep(0.0, -smoothness, r - (p * (1.0 + smoothness)));

            return win * reveal;
        }
        "
    }
}
