/*
Title: wave-warp
Authors: liixini | https://github.com/liixini 
Desc: imported from https://github.com/liixini/shaders
*/

animations {
   workspace-switch {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }
	horizontal-view-movement {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    config-notification-open-close {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    exit-confirmation-open-close {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }

    overview-open-close {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    recent-windows-close {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    window-open {
		duration-ms 500
		curve "ease-out-cubic"
        custom-shader r"

        // Ported from skwd-wall wave-warp transition

        vec4 open_color(vec3 coords_geo, vec3 size_geo) {
            float p = niri_clamped_progress;
            vec2 uv = coords_geo.xy;

            float smoothness = 0.5;
            vec2 dir = vec2(1.0, 0.0);
            vec2 v = normalize(dir);
            v /= abs(v.x) + abs(v.y);
            float d = v.x * 0.5 + v.y * 0.5;
            float m = 1.0 - smoothstep(-smoothness, 0.0, v.x * uv.x + v.y * uv.y - (d - 0.5 + p * (1.0 + smoothness)));

            vec2 warped = clamp((uv - 0.5) * m + 0.5, vec2(0.0), vec2(1.0));
            vec3 tc = niri_geo_to_tex * vec3(warped, 1.0);
            vec4 win = texture2D(niri_tex, tc.st);

            float in_bounds = step(0.0, uv.x) * step(uv.x, 1.0) * step(0.0, uv.y) * step(uv.y, 1.0);
            return win * m * in_bounds;
        }
        "
    }

    window-close {
       	duration-ms 500
       	curve "ease-out-cubic"
        custom-shader r"

        // Ported from skwd-wall wave-warp transition

        vec4 close_color(vec3 coords_geo, vec3 size_geo) {
            float p = 1.0 - niri_clamped_progress;
            vec2 uv = coords_geo.xy;

            float smoothness = 0.5;
            vec2 dir = vec2(1.0, 0.0);
            vec2 v = normalize(dir);
            v /= abs(v.x) + abs(v.y);
            float d = v.x * 0.5 + v.y * 0.5;
            float m = 1.0 - smoothstep(-smoothness, 0.0, v.x * uv.x + v.y * uv.y - (d - 0.5 + p * (1.0 + smoothness)));

            vec2 warped = clamp((uv - 0.5) * m + 0.5, vec2(0.0), vec2(1.0));
            vec3 tc = niri_geo_to_tex * vec3(warped, 1.0);
            vec4 win = texture2D(niri_tex, tc.st);

            float in_bounds = step(0.0, uv.x) * step(uv.x, 1.0) * step(0.0, uv.y) * step(uv.y, 1.0);
            return win * m * in_bounds;
        }
        "
    }
}
