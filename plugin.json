{
  "id": "animationRotate",
  "name": "Animation Rotate",
  "description": "Rotate niri window animations from the Control Center: switch presets, auto/manual rotation on window events, and cooldown debounce. Native DMS daemon — no bundled binaries.",
  "version": "2.0.0",
  "author": "pnbarbeito",
  "icon": "animation",
  "type": "composite",
  "components": {
    "daemon": "./AnimationRotateDaemon.qml",
    "widget": "./AnimationRotateWidget.qml"
  },
  "settings": "./AnimationRotateSettings.qml",
  "capabilities": [
    "control-center",
    "dankbar-widget",
    "daemon"
  ],
  "category": "utilities",
  "compositors": [
    "niri"
  ],
  "distro": [
    "any"
  ],
  "dependencies": [
    "niri"
  ],
  "requires_dms": ">=1.5.0",
  "permissions": [
    "process",
    "settings_read",
    "settings_write"
  ]
}
